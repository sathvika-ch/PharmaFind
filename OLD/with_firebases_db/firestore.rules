rules_version = '2';

/* ============================================================
   PharmaFind — Firestore security rules (email-link edition)
   ------------------------------------------------------------
   These are the REAL access control. The JavaScript checks in the
   app are only UI — THESE rules are what actually protect the data.

   Ownership is denormalized onto docs (ownerUserId on inventory &
   bills, pharmacyOwnerId & patientId on reservations) so a rule can
   check access without an extra lookup.

   ADMIN BOOTSTRAP: the first admin is decided by email. Put your
   email in adminEmails() below — it MUST match the ADMIN_EMAILS
   list in firebase-config.js.

   HOW TO APPLY:
     Firebase console → Firestore Database → Rules → paste → Publish.
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    // 🔽🔽 CHANGE THIS to your real email (match firebase-config.js) 🔽🔽
    function adminEmails() {
      return ['chavanaboinasathvika@gmail.com'];
    }

    function signedIn() { return request.auth != null; }

    function myEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower() : '';
    }

    function isAdminEmail() { return myEmail() in adminEmails(); }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    /* ---------- users ----------
       Read your own profile; admins read everyone.
       Create your OWN doc as patient/pharmacy — or as admin only if
       your email is in the admin list. Admins may create/edit/delete
       any account. You may edit your own profile but NOT change your
       own role. */
    match /users/{uid} {
      allow read:   if request.auth.uid == uid || isAdmin();
      allow create: if isAdmin()
                    || (request.auth.uid == uid && (
                          request.resource.data.role in ['patient', 'pharmacy']
                          || (request.resource.data.role == 'admin' && isAdminEmail())
                        ));
      allow update: if isAdmin()
                    || (request.auth.uid == uid
                        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    /* ---------- medicines (public catalog) ---------- */
    match /medicines/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /* ---------- pharmacies ----------
       Public read. A signed-in user registers a store (starts
       'pending'). Owner edits details but can't self-approve or
       transfer ownership. Admin does anything. */
    match /pharmacies/{id} {
      allow read:   if true;
      allow create: if isAdmin()
                    || (signedIn()
                        && request.resource.data.ownerUserId == request.auth.uid
                        && request.resource.data.status == 'pending');
      allow update: if isAdmin()
                    || (resource.data.ownerUserId == request.auth.uid
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.ownerUserId == resource.data.ownerUserId);
      allow delete: if isAdmin();
    }

    /* ---------- inventory ----------
       Public read (stock is what patients search). Writes only by the
       owning pharmacy or admin. The billing transaction is covered by
       the update rule. */
    match /inventory/{id} {
      allow read:   if true;
      allow create: if isAdmin() || request.resource.data.ownerUserId == request.auth.uid;
      allow update: if isAdmin() || resource.data.ownerUserId == request.auth.uid;
      allow delete: if isAdmin() || resource.data.ownerUserId == request.auth.uid;
    }

    /* ---------- reservations ----------
       Readable by the patient, the owning pharmacy, or admin. A patient
       creates it for themselves (now with payment info). The pharmacy
       or admin updates status. */
    match /reservations/{id} {
      allow read:   if isAdmin()
                    || resource.data.patientId == request.auth.uid
                    || resource.data.pharmacyOwnerId == request.auth.uid;
      allow create: if request.resource.data.patientId == request.auth.uid;
      allow update: if isAdmin() || resource.data.pharmacyOwnerId == request.auth.uid;
      allow delete: if isAdmin();
    }

    /* ---------- bills (permanent record) ---------- */
    match /bills/{id} {
      allow read:   if isAdmin() || resource.data.ownerUserId == request.auth.uid;
      allow create: if request.resource.data.ownerUserId == request.auth.uid;
      allow update, delete: if false;
    }

    /* ---------- notifications ---------- */
    match /notifications/{id} {
      allow read:   if isAdmin() || resource.data.userId == request.auth.uid;
      allow create: if signedIn();
      allow update: if resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || resource.data.userId == request.auth.uid;
    }
  }
}
